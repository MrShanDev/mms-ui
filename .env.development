########################################项目配置###################################

# 本地环境
ENV = development

# 接口请求地址
VITE_APP_BASE=''

# 本地环境Vite接口代理
VITE_APP_BASE_API='/prod-api'

# 本地环境接口地址（Vite 把 /prod-api 代理到此处）
# 联调本机后端请用 localhost；若指到线上 prod-api，浏览器 Origin 仍是 http://localhost:端口，
# 而线上 prod 默认 mms.cors.allowed-origins 为空，会报 Invalid CORS request。
VITE_APP_API_URL='http://localhost:8080'
#VITE_APP_API_URL='https://demo.mmsadmin.cn'

# syslog 插件联邦：先 pnpm run fed:plugin-ui:dev -- @mms-ui/plugin-syslog-ui（默认 5175），与 packages/plugin-syslog-ui 的 base 一致
VITE_SYSLOG_REMOTE_ENTRY=http://localhost:5175/assets/remoteEntry.js

# 本地Socket地址
VITE_APP_WS_URL='ws://localhost:8080/ws'

# 客户端id
VITE_APP_CLIENT_ID='e5cd7e4891bf95d1d19206ce24a7b32e'

########################################项目信息###################################

# 页面标题
VITE_APP_TITLE='模块化管理系统'

# 页面副标题
VITE_APP_VICE_TITLE='模块化管理系统（Modular management system），简称：MMS。'

# 页面描述
VITE_APP_VICE_TITLE_MSG='MMS（模块化管理系统，Modular Management System）基于Spring Boot 3.x构建，采用前后端分离的现代化架构设计。该系统集成了用户管理、商品管理、支付系统、订单处理、分销体系、日志监控、定时任务、通信服务、直播支持、广告管理与内容发布等多个功能模块，致力于为开发者提供高效、稳定且可扩展的开发脚手架，显著提升项目开发效率，助力各类应用快速落地与迭代。!'

ENCRYPT_KEY=""
