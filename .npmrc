# NPM 镜像加速配置
# 淘宝镜像（推荐，国内访问最快）
registry=https://registry.npmmirror.com

# 特定作用域的镜像配置
@vue:registry=https://registry.npmmirror.com
@vite:registry=https://registry.npmmirror.com
@element-plus:registry=https://registry.npmmirror.com
@types:registry=https://registry.npmmirror.com

# 缓存配置
cache=~/.npm
# cache-min 已废弃，使用 prefer-offline 替代
# cache-min=86400

# 网络配置 - 优化下载性能
fetch-timeout=300000
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-retries=3

# 安全和审计配置
audit-level=moderate
fund=false

# 包管理配置
save-exact=false
package-lock=true
# shrinkwrap 已废弃，package-lock 替代
# shrinkwrap=false

# 性能优化
prefer-offline=false
engine-strict=false

# 代理配置（如果需要，取消注释）
# proxy=http://proxy.company.com:8080
# https-proxy=http://proxy.company.com:8080

# 备用镜像源（注释掉的备选方案）
# 华为云镜像
# registry=https://repo.huaweicloud.com/repository/npm/
# 腾讯云镜像
# registry=https://mirrors.cloud.tencent.com/npm/
# 官方镜像
# registry=https://registry.npmjs.org/