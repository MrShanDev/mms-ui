{
	"name": "mms-ui",
	"version": "1.0.8",
	"description": "Vue3 Vite is used for the backend template of the modular management system.",
	"author": "品创网络",
	"license": "MIT",
	"scripts": {
		"dev": "vite --mode development --open",
		"build": "vite build --mode production",
		"lint": "eslint --ext .js,.jsx,.ts,.tsx,.vue src/",
		"lint:fix": "eslint --ext .js,.jsx,.ts,.tsx,.vue src/ --fix",
		"type-check": "vue-tsc --noEmit",
		"format": "prettier --write \"src/**/*.{vue,js,jsx,ts,tsx,json,css,scss,md}\"",
		"format:check": "prettier --check \"src/**/*.{vue,js,jsx,ts,tsx,json,css,scss,md}\"",
		"format:lint": "npm run lint && npm run format",
		"pre-commit": "npm run lint && npm run format:check",
		"build:dev": "vite build --mode development",
		"clean": "rm -rf dist node_modules/.vite",
		"clean:cache": "rm -rf node_modules/.vite node_modules/.cache",
		"clean:deps": "rm -rf node_modules pnpm-lock.yaml && pnpm install",
		"dev:fresh": "rm -rf node_modules/.vite && vite --mode development --open",
		"mirror:setup": "bash scripts/setup-npm-mirrors.sh",
		"mirror:verify": "bash scripts/verify-mirrors.sh",
		"mirror:taobao": "npm config set registry https://registry.npmmirror.com",
		"mirror:official": "npm config set registry https://registry.npmjs.org/",
		"mirror:test": "npm config get registry && npm view vue version",
		"install:fast": "npm install --registry=https://registry.npmmirror.com",
		"pnpm:install": "pnpm install --registry=https://registry.npmmirror.com",
		"pnpm:setup": "npm install -g pnpm && pnpm config set registry https://registry.npmmirror.com",
		"pnpm:clean": "pnpm store prune && rm -rf node_modules",
		"start:pnpm": "./scripts/start-pnpm.sh",
		"start:pnpm:win": "powershell -ExecutionPolicy Bypass -File ./scripts/start-pnpm.ps1",
		"mms": "./scripts/mms.sh",
		"mms:win": "powershell -ExecutionPolicy Bypass -File ./scripts/mms.ps1",
		"fed:remote:sample:dev": "pnpm --filter @mms-ui/plugin-remote-sample dev",
		"fed:remote:sample:build": "pnpm --filter @mms-ui/plugin-remote-sample build",
		"fed:syslog-ui:dev": "pnpm --filter @mms-ui/plugin-syslog-ui dev",
		"fed:syslog-ui:build": "pnpm --filter @mms-ui/plugin-syslog-ui build"
	},
	"dependencies": {
		"@element-plus/icons-vue": "^2.3.2",
		"@iconify/vue": "^5.0.0",
		"@vueuse/core": "^13.1.0",
		"@vxe-ui/core": "^4.0.39",
		"@wangeditor/editor": "^5.1.23",
		"@wangeditor/editor-for-vue": "^5.1.12",
		"animate.css": "^4.1.1",
		"axios": "^1.3.5",
		"countup.js": "^2.6.0",
		"cropperjs": "^1.5.13",
		"crypto-js": "^4.2.0",
		"echarts": "^5.4.2",
		"echarts-gl": "^2.0.9",
		"echarts-wordcloud": "^2.1.0",
		"element-plus": "^2.11.2",
		"file-saver": "^2.0.5",
		"hover.css": "^2.3.2",
		"iframe-resizer": "^4.4.0",
		"js-cookie": "^3.0.1",
		"js-table2excel": "^1.0.3",
		"jsplumb": "^2.15.6",
		"marked": "^15.0.8",
		"mitt": "^3.0.0",
		"nprogress": "^0.2.0",
		"pinia": "^2.0.34",
		"print-js": "^1.6.0",
		"prismjs": "^1.30.0",
		"qrcodejs2-fixes": "^0.0.2",
		"qs": "^6.11.1",
		"screenfull": "^6.0.2",
		"sortablejs": "^1.15.0",
		"splitpanes": "^3.1.5",
		"video.js": "^8.23.4",
		"videojs": "^1.0.0",
		"vue": "^3.5.21",
		"vue-clipboard3": "^2.0.0",
		"vue-data-ui": "^3.0.2",
		"vue-grid-layout": "^3.0.0-beta1",
		"vue-i18n": "^9.2.2",
		"vue-router": "4.3.2",
		"vxe-pc-ui": "4.5.25",
		"vxe-table": "4.7.87"
	},
	"devDependencies": {
		"@originjs/vite-plugin-federation": "^1.4.1",
		"@types/crypto-js": "^4.1.1",
		"@types/file-saver": "^2.0.7",
		"@types/js-cookie": "^3.0.0",
		"@types/node": "^24.3.1",
		"@types/nprogress": "^0.2.0",
		"@types/qs": "6.9.7",
		"@types/sortablejs": "^1.15.1",
		"@typescript-eslint/eslint-plugin": "^6.21.0",
		"@typescript-eslint/parser": "^6.21.0",
		"@vitejs/plugin-vue": "^5.2.4",
		"@vue/compiler-sfc": "^3.5.21",
		"eslint": "^8.57.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.4",
		"eslint-plugin-vue": "^9.33.0",
		"less": "^4.2.0",
		"prettier": "^3.6.2",
		"rollup": "^2.25.0",
		"sass": "^1.80.3",
		"typescript": "^5.9.2",
		"unplugin-auto-import": "^0.18.3",
		"unplugin-vue-components": "^29.0.0",
		"vite": "^6.3.5",
		"vite-plugin-cdn-import": "^0.3.5",
		"vite-plugin-compression": "^0.5.1",
		"vite-plugin-inspect": "^11.3.3",
		"vite-plugin-lazy-import": "^1.0.7",
		"vite-plugin-svg-icons": "2.0.1",
		"vite-plugin-vue-setup-extend-plus": "^0.1.0",
		"vite-plugin-windicss": "^1.9.3",
		"vue-tsc": "^2.2.12",
		"windicss": "^3.5.6"
	},
	"rules": {},
	"browserslist": [
		"> 1%",
		"last 2 versions",
		"not dead"
	],
	"bugs": {
		"url": "https://gitee.com/shanpengnian/mms/issues"
	},
	"engines": {
		"node": ">=18.0.0",
		"npm": ">= 8.0.0"
	},
	"keywords": [
		"vue",
		"vue3",
		"vuejs/vue-next",
		"element-ui",
		"element-plus",
		"mms",
		"mms-admin"
	],
	"repository": {
		"type": "git",
		"url": "https://gitee.com/shanpengnian/mms"
	}
}
