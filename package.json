{
	"name": "mms-ui",
	"version": "1.1.0",
	"description": "Vue3 Vite is used for the backend template of the modular management system.",
	"author": "品创网络",
	"license": "MIT",

	"scripts": {
		"dev": "vite --mode development --open",
		"preview": "vite --mode preview --open",
		"prod": "vite --mode production --open",
		"build": "vite build --mode production",
		"lint": "eslint --ext .js,.jsx,.ts,.tsx,.vue src/",
		"lint:fix": "eslint --ext .js,.jsx,.ts,.tsx,.vue src/ --fix",
		"type-check": "vue-tsc --noEmit",
		"format": "prettier --write \"src/**/*.{vue,js,jsx,ts,tsx,json,css,scss,md}\"",
		"format:check": "prettier --check \"src/**/*.{vue,js,jsx,ts,tsx,json,css,scss,md}\"",
		"format:lint": "npm run lint && npm run format",
		"pre-commit": "npm run lint && npm run format:check",

		"serve": "vite preview",
		"build:dev": "vite build --mode development",
		"clean": "rm -rf dist node_modules/.vite"
	},


	"dependencies": {
		"element-plus": "2.7.8",
		"@element-plus/icons-vue": "2.3.1",
		"vxe-table": "4.7.87",
