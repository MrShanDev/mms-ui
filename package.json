{
	"name": "mms-ui",
	"version": "1.0.8",
	"description": "Vue3 Vite is used for the backend template of the modular management system.",
	"author": "品创网络",
	"license": "MIT",
	"scripts": {
		"dev": "vite --mode development --open",
		"plug": "vite --mode plug --open",
		"build": "vite build --mode production",
		"preview": "vite preview",
		"lint": "eslint --ext .js,.jsx,.ts,.tsx,.vue src/",
		"lint:fix": "eslint --ext .js,.jsx,.ts,.tsx,.vue src/ --fix",
		"type-check": "vue-tsc --noEmit",
		"format": "prettier --write \"src/**/*.{vue,js,jsx,ts,tsx,json,css,scss,md}\"",
		"format:check": "prettier --check \"src/**/*.{vue,js,jsx,ts,tsx,json,css,scss,md}\"",
		"format:lint": "pnpm run lint && pnpm run format",
		"pre-commit": "pnpm run lint && pnpm run format:check",
		"fed:plugin-ui:build": "node ./scripts/fed-plugin-ui.mjs build",
		"fed:plugin-ui:dev": "node ./scripts/fed-plugin-ui.mjs dev",
		"mms": "bash ./scripts/mms.sh",
		"mms:win": "powershell -ExecutionPolicy Bypass -File ./scripts/mms.ps1"
	},
	"dependencies": {
		"@element-plus/icons-vue": "^2.3.2",
