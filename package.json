		"@vxe-ui/core": "^4.0.39",

		"vue": "^3.5.11",
		"vue-router": "4.3.2",
		"pinia": "^2.0.34",
		"vue-i18n": "^9.2.2",
		"@vueuse/core": "^13.1.0",


		"axios": "^1.3.5",
		"qs": "^6.11.1",
		"js-cookie": "^3.0.1",
		"crypto-js": "^4.2.0",
		"mitt": "^3.0.0",
		"nprogress": "^0.2.0",


		"echarts": "^5.4.2",
		"echarts-gl": "^2.0.9",
		"echarts-wordcloud": "^2.1.0",
		"vue-data-ui": "^3.0.2",


		"@wangeditor/editor": "^5.1.23",
		"@wangeditor/editor-for-vue": "^5.1.12",
		"marked": "^15.0.8",
		"prismjs": "^1.30.0",


		"file-saver": "^2.0.5",
		"js-table2excel": "^1.0.3",
		"print-js": "^1.6.0",


		"animate.css": "^4.1.1",
		"countup.js": "^2.6.0",
		"cropperjs": "^1.5.13",
		"iframe-resizer": "^4.4.0",
		"jsplumb": "^2.15.6",
		"qrcodejs2-fixes": "^0.0.2",
		"screenfull": "^6.0.2",
		"sortablejs": "^1.15.0",
		"splitpanes": "^3.1.5",
		"vue-clipboard3": "^2.0.0",
		"vue-grid-layout": "^3.0.0-beta1"
	},


	"devDependencies": {

		"vite": "5.2.12",
