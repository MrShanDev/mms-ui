		"@typescript-eslint/eslint-plugin": "^6.21.0",
		"eslint-plugin-vue": "^9.33.0",


		"prettier": "^3.6.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.4",


		"less": "^4.2.0",
		"sass": "^1.80.3",
		"windicss": "^3.5.6",
