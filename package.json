		"hover.css": "^2.3.2",
		"iframe-resizer": "^4.4.0",
		"js-cookie": "^3.0.1",
		"js-table2excel": "^1.0.3",
		"jsplumb": "^2.15.6",
		"marked": "^15.0.8",
		"mitt": "^3.0.0",
		"nprogress": "^0.2.0",
